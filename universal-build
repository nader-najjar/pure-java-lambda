#!/usr/bin/env sh
set -eu

if ! command -v nix >/dev/null 2>&1; then
  printf '\033[31mUNIVERSAL BUILD: Nix is required. Install from https://nix.dev/install-nix\033[0m\n' >&2
  exit 1
fi

exec nix \
  --extra-experimental-features 'nix-command flakes' \
  run \
  --no-update-lock-file \
  github:nader-najjar/universal-build/1ad4719c1839ddfd5cdb7a9d5a8eee1848649c8f \
  -- "$@"
